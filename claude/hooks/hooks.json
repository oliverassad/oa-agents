{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/inject_rules.py\" SessionStart" }] }
    ],
    "SubagentStart": [
      { "hooks": [{ "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/inject_rules.py\" SubagentStart" }] }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/rtk_guard.py\"" },
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/rtk_rewrite.sh\"" }
        ]
      }
    ]
  }
}
